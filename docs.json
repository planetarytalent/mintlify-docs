{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Planetary Talent",
  "description": "How to hire with Planetary Talent, the hiring accelerator for founder-led companies. Open a role, review a shortlist of interview-ready humans, and hire anywhere on Earth.",
  "colors": {
    "primary": "#ED6033",
    "light": "#ED6033",
    "dark": "#ED6033"
  },
  "background": {
    "color": {
      "light": "#F7F3F2",
      "dark": "#121314"
    }
  },
  "fonts": {
    "heading": {
      "family": "DM Sans",
      "weight": 500
    },
    "body": {
      "family": "DM Sans",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.planetarytalent.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "getting-started/open-a-role"
            ]
          },
          {
            "group": "How it works",
            "pages": [
              "how-it-works/overview",
              "how-it-works/search-tiers"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "planetarytalent.com",
          "href": "https://www.planetarytalent.com",
          "icon": "world"
        },
        {
          "anchor": "Pricing",
          "href": "https://www.planetarytalent.com/pricing",
          "icon": "tag"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Apply for a role",
        "href": "https://app.planetarytalent.com/apply"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start hiring",
      "href": "https://www.planetarytalent.com/start-hiring"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp"
    ]
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:site_name": "Planetary Talent docs",
      "og:type": "website",
      "twitter:site": "@planetarytal"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/planetarytalent",
      "x": "https://x.com/planetarytal",
      "instagram": "https://instagram.com/planetarytalent"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Start hiring",
            "href": "https://www.planetarytalent.com/start-hiring"
