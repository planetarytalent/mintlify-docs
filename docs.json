            "label": "Pricing",
            "href": "https://www.planetarytalent.com/pricing"
          },
          {
            "label": "FAQs",
            "href": "https://www.planetarytalent.com/faqs"
          }
        ]
      },
      {
        "header": "Company",
        "items": [
          {
            "label": "Values",
            "href": "https://www.planetarytalent.com/values"
          },
          {
            "label": "Blog",
            "href": "https://www.planetarytalent.com/blog"
          },
          {
            "label": "Contact",
            "href": "mailto:hello@planetarytalent.com"
          }
        ]
      }
